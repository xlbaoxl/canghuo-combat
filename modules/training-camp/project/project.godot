config_version=5

[application]
config/name="藏火 · 战斗训练营"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/version="3.0.1"
config/icon="res://assets/icon.svg"
run/max_fps=30

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=false
window/stretch/mode="viewport"

[rendering]
renderer/rendering_method="mobile"
rendering_device/driver.windows="d3d12"
rendering_device/fallback_to_vulkan=false
rendering_device/fallback_to_opengl3=true
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.035,0.06,0.075,1)

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/integer_division=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
